# Conexión a PostgreSQL. Para Docker local usa el valor de abajo.
# Para Supabase: copia la "Connection string" (modo session) de tu proyecto.
DATABASE_URL=postgresql+psycopg://spazio:spazio@localhost:5432/spazio

# Clave para firmar los JWT (cámbiala en producción).
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_EXPIRE_MINUTES=720

# Minutos de retención de la reserva mientras se paga (RF-07).
BOOKING_HOLD_MINUTES=10

# Orígenes permitidos por CORS (el frontend de Vite).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Servicio de geocodificación (Nominatim / OpenStreetMap).
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Wompi (sandbox). Obtén estas llaves en el dashboard de Wompi.
# La privada y el integrity secret son SECRETOS: solo en el backend.
WOMPI_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxx
